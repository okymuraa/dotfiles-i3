#############################################################
# SERVICIOS / AUTOSTART
#############################################################

# Cerrar servicios de XFCE que no queremos
exec --no-startup-id killall xfwm4
exec --no-startup-id killall xfce4-panel

# Reemplazar configuraciones de XFCE (tema, fuentes, etc.)
exec --no-startup-id xfsettingsd --replace

# Notificaciones
exec --no-startup-id xfce4-notifyd

# Compositor picom
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

# xbindkeys para botones del mouse
exec --no-startup-id xbindkeys

# NetworkManager applet
exec --no-startup-id nm-applet

# Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh
# (o si usas otro script)
# exec_always --no-startup-id ~/.config/polybar/polybar.sh

# Wallpaper
exec_always --no-startup-id feh --bg-fill /home/okymuraa/Imágenes/wallpapers/wall-65.png


#############################################################
# CONFIGURACIÓN BÁSICA / LOOK & FEEL
#############################################################

set $mod Mod4
font pango:Inter 12

# Gaps
gaps inner 10
gaps outer 5

# Modificador para mover ventanas con el mouse
floating_modifier $mod

# Arrastrar tiled con la barra de título (i3 >= 4.22)
tiling_drag modifier titlebar

# Bordes
default_border pixel 3
default_floating_border pixel 3

# Colores de ventanas
# class                 border   back     text    indicator child_border
client.focused          #10232e  #10232e  #282a36 #10232e   #10232e
client.focused_inactive #44475a  #44475a  #ffffff #44475a   #44475a
client.unfocused        #282a36  #282a36  #888888 #282a36   #282a36
client.urgent           #ff5555  #ff5555  #ffffff #ff5555   #ff5555
client.placeholder      #000000  #0c0c0c  #ffffff #000000   #0c0c0c
client.background       #ffffff


#############################################################
# ATAJOS GENERALES
#############################################################

# Terminal
bindsym $mod+Return exec --no-startup-id xfce4-terminal

# Lanzador de aplicaciones (rofi)
bindsym $mod+space exec --no-startup-id rofi -no-lazy-grab -show-icons -show drun

# Cerrar ventana
bindsym $mod+q kill

# Apagado / powermenu
bindsym $mod+Shift+q exec ~/.local/bin/powermenu.sh

# CONTROL DE FOCO (VIM-STYLE)
bindsym $mod+a focus left
bindsym $mod+s focus down
bindsym $mod+w focus up
bindsym $mod+d focus right

# MOVER VENTANAS (VIM-STYLE)
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+i move up
bindsym $mod+Shift+l move right

# MOVER VENTANAS CON FLECHAS
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# SPLIT / FULLSCREEN / FLOATING
bindsym $mod+h split h
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+t floating toggle
bindsym $mod+Shift+space focus mode_toggle
#bindsym $mod+a focus parent

# COMANDOS DE I3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-msg exit"

# MODO RESIZE
mode "resize" {
    bindsym j      resize shrink width 10 px or 10 ppt
    bindsym k      resize grow   height 10 px or 10 ppt
    bindsym l      resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left   resize shrink width 10 px or 10 ppt
    bindsym Down   resize grow   height 10 px or 10 ppt
    bindsym Up     resize shrink height 10 px or 10 ppt
    bindsym Right  resize grow   width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


#############################################################
# MULTIMEDIA / SISTEMA
#############################################################

# Volumen
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ toggle

# Captura de pantalla (área)
bindsym $mod+Mod1+s exec xfce4-screenshooter -r


#############################################################
# WORKSPACES / NAVEGACIÓN
#############################################################

# Monitores
set $monitor1 eDP-1
set $monitor2 HDMI-1-1

# Asignar workspaces a monitores
workspace 1  output $monitor1
workspace 2  output $monitor1
workspace 3  output $monitor1
workspace 4  output $monitor1
workspace 5  output $monitor1
workspace 6  output $monitor2
workspace 7  output $monitor2
workspace 8  output $monitor2
workspace 9  output $monitor2
workspace 10 output $monitor2

# Variables de workspaces
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

# Ir a workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Mover ventana al workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Cambiar de workspace
bindsym $mod+Left  workspace prev
bindsym $mod+Right workspace next

# Workspace anterior
bindsym $mod+Tab workspace back_and_forth

# Anterior / siguiente en mismo monitor
bindsym $mod+Control+Left  workspace prev_on_output
bindsym $mod+Control+Right workspace next_on_output


#############################################################
# VENTANAS FLOTANTES ESPECIALES
#############################################################

for_window [class="Pavucontrol"]        floating enable
for_window [class="Blueman-manager"]    floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [title="Picture-in-Picture"] floating enable sticky enable

# Ejemplo tamaño específico
for_window [class="calculator"] floating en
